# Optional Feishu API credentials.
# Do not commit real secrets.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Optional Gmail + Feishu sync paths.
# Keep these files outside the repo and chmod 600 when possible.
FEISHU_CONFIG_PATH=/Users/you/.codex/feishu_config.json
GMAIL_OAUTH_CLIENT=/Users/you/.codex/gmail_oauth_client.json
GMAIL_TOKEN_PATH=/Users/you/.codex/gmail_token.json

# Optional AI draft generation. If omitted, the Gmail sync script falls back
# to a conservative template draft.
OPENROUTER_API_KEY=sk-or-v1_xxx
OPENROUTER_MODEL=google/gemini-2.5-flash
